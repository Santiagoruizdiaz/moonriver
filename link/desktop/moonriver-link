#!/usr/bin/env python3
"""moonriver-link: mandar cosas al teléfono desde la terminal o desde Archivos.

  moonriver-link send ARCHIVO...    manda archivos
  moonriver-link text "texto/link"  manda texto o un link (se abre en el teléfono)
  moonriver-link status             muestra el estado de los teléfonos vinculados
"""
import json
import os
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402


def call(method, params=None):
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return bus.call_sync("org.moonriver.Link", "/org/moonriver/Link", "org.moonriver.Link",
                         method, params, None, Gio.DBusCallFlags.NONE, 5000, None)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[1], argv[2:]
    try:
        if cmd == "send" and args:
            paths = [os.path.abspath(p) for p in args if os.path.isfile(p)]
            call("SendFiles", GLib.Variant("(as)", (paths,)))
            print(f"{len(paths)} archivo(s) en camino al teléfono")
        elif cmd == "text" and args:
            call("SendText", GLib.Variant("(s)", (" ".join(args),)))
        elif cmd == "status":
            status = json.loads(call("GetStatus").unpack()[0])
            if not status["devices"]:
                print("No hay teléfonos vinculados.")
            for d in status["devices"]:
                state = "conectado" if d["connected"] else "desconectado"
                battery = f" · batería {d['battery']}%" if d["battery"] is not None else ""
                print(f"{d['name']}: {state}{battery}")
        else:
            print(__doc__.strip())
            return 1
    except GLib.Error as e:
        print(f"Moonriver Link no está corriendo ({e.message})", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
