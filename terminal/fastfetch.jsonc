// Moonriver para fastfetch — se instala en ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/moonriver.txt",
        "color": {
            "1": "38;2;212;42;82",
            "2": "38;2;163;24;58",
            "3": "38;2;110;14;34"
        },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;196;35;74",
            "title": "38;2;255;120;150",
            "separator": "38;2;74;10;23"
        },
        "key": { "width": 11 }
    },
    "modules": [
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "separator", "string": "─" },
        { "type": "os", "key": "Sistema", "format": "Moonriver {arch} · basado en Fedora {version-id}" },
        { "type": "de", "key": "Escritorio", "format": "Moonriver sobre GNOME {version}" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "host", "key": "Equipo" },
        { "type": "uptime", "key": "Encendida" },
        { "type": "packages", "key": "Paquetes" },
        { "type": "shell", "key": "Shell" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memoria" },
        { "type": "disk", "key": "Disco", "folders": "/" },
        { "type": "battery", "key": "Batería" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
